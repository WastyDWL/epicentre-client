    [==[$<TARGET_FILE:engine_mini>]==]
    [==[$<TARGET_FILE:filesystem_proxy>]==]
    [==[$<TARGET_FILE:client_mini>]==]
    [==[$<TARGET_FILE:gameui>]==]
    [==[$<TARGET_FILE:steam_api_proxy>]==]
    [==[$<TARGET_FILE:nitro_api>]==]
    [==[$<TARGET_FILE:vgui2>]==])
