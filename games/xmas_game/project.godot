; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Christmas Game"
config/description="Санта ловит подарки: 30 секунд, конфеты, снежинки и ускорение."
run/main_scene="res://game/Run.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0784314, 0.0823529, 0.101961, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

SiteBridge="*res://scripts/site_bridge.gd"

[display]

window/size/viewport_width=1800
window/size/viewport_height=893
window/size/window_width_override=1280
window/size/window_height_override=635
window/stretch/mode="canvas_items"
; родная сборка встраивается в меню клиента и ввод получает от него: окно не должно забирать
; фокус у CS (полноэкранная CS сворачивается при потере фокуса)
window/size/no_focus.windows=true

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[gui]

theme/custom="res://WorldTheme.tres"

